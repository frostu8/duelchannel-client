{
	"name": "duelchannel-client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "npm run smui-theme-light && npm run smui-theme-dark",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"smui-theme-light": "smui-theme compile static/smui.css -i src/theme -i node_modules",
		"smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark -i node_modules"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@mdi/js": "^7.4.47",
		"@smui/button": "^9.0.0",
		"@smui/card": "^9.0.0",
		"@smui/common": "^9.0.0",
		"@smui/floating-label": "^9.0.0",
		"@smui/line-ripple": "^9.0.0",
		"@smui/notched-outline": "^9.0.0",
		"@smui/ripple": "^9.0.0",
		"@smui/textfield": "^9.0.0",
		"@smui/touch-target": "^9.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^24",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"smui-theme": "^9.0.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.3",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.1.46",
		"dotenv": "^17.4.2"
	}
}
